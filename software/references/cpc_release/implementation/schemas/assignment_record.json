{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assignment_record.json",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "contract_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "profile_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "experiment_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "unit_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "context_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_type": {
      "type": "string",
      "const": "assignment",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "predecessor_record_id": {
      "type": "null"
    },
    "predecessor_digest": {
      "type": "null"
    },
    "payload": {
      "$ref": "assignment_payload.json"
    },
    "integrity": {
      "$ref": "integrity.json"
    },
    "extensions": {
      "$ref": "extensions.json"
    }
  },
  "required": [
    "record_id",
    "contract_version",
    "profile_id",
    "profile_version",
    "schema_version",
    "experiment_id",
    "experiment_version",
    "unit_token",
    "issuer",
    "audience",
    "deployment_id",
    "context_id",
    "nonce",
    "issued_at",
    "valid_from",
    "expires_at",
    "record_type",
    "predecessor_record_id",
    "predecessor_digest",
    "payload",
    "integrity"
  ],
  "additionalProperties": false
}

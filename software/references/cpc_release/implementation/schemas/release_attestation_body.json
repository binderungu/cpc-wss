{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release_attestation_body.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "profile_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "experiment_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "unit_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "context_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "proof_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "clock_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "commitment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "format": "identifier"
    },
    "exposure_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "release_boundary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "extensions": {
      "$ref": "extensions.json"
    }
  },
  "required": [
    "contract_version",
    "profile_id",
    "profile_version",
    "experiment_id",
    "experiment_version",
    "unit_token",
    "audience",
    "deployment_id",
    "context_id",
    "proof_id",
    "issuer",
    "issued_at",
    "valid_from",
    "expires_at",
    "clock_id",
    "sequence",
    "invocation_id",
    "commitment_digest",
    "exposure_record_id",
    "release_boundary"
  ],
  "additionalProperties": false
}

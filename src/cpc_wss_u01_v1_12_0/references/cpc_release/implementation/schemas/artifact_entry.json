{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact_entry.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "format": "identifier"
    },
    "evidence_mode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "format": "identifier"
    }
  },
  "required": [
    "version",
    "digest",
    "evidence_mode"
  ],
  "additionalProperties": false
}
